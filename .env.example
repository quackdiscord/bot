# Local development settings. Copy to .env and fill in the Discord values.
#
# Quack reads QUACK_* variables from the process environment; it does not read
# .env itself. air (apps/backend/.air.toml) and Docker Compose load this file
# for you. For anything else: set -a; source .env; set +a
#
# Every setting has a default; this file lists only what you usually change.
# See docs/configuration.md for the full list. Durations are Go durations
# ("15s", "168h") and rate limits are "<max>/<window>" ("120/1m").

QUACK_ENVIRONMENT=dev

# Storage. These point at `docker compose up -d` from the host. The Compose
# app profile overrides them with container hostnames.
QUACK_DATABASE_DSN='quack:quack@tcp(127.0.0.1:3306)/quack?charset=utf8mb4&parseTime=True&loc=Local'
QUACK_REDIS_URL=redis://127.0.0.1:6379/0

# Discord. Use a separate development application, not the production one.
QUACK_DISCORD_TOKEN=
QUACK_DISCORD_APP_ID=
QUACK_DISCORD_CLIENT_SECRET=
QUACK_DISCORD_OAUTH_REDIRECT_URI=http://localhost:8080/auth/discord/callback
# Sync slash commands to one test guild; this applies instantly.
QUACK_DISCORD_COMMAND_GUILD_ID=
QUACK_DISCORD_COMMAND_PRUNE=false

# HTTP API.
QUACK_API_PORT=8080
QUACK_API_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
QUACK_API_OPS_TOKEN=
QUACK_API_METRICS_TOKEN=

# Logging: debug, info, warn, or error.
QUACK_LOG_LEVEL=info
